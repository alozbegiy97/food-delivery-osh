# Copy this file to `.env` and fill in the required values.
# `.env` is ignored by git and must never be committed.
# Passwords are used inside database URLs: use only URL-safe characters
# (letters, digits, `-`, `_`, `.`).

# --- Main database (required) ---
POSTGRES_DB=food_delivery
POSTGRES_USER=food_delivery
POSTGRES_PASSWORD=

# --- Isolated test database (required for pytest; data lives in tmpfs) ---
TEST_POSTGRES_DB=food_delivery_test
TEST_POSTGRES_USER=food_delivery_test
TEST_POSTGRES_PASSWORD=

# --- Backend ---
LOG_LEVEL=INFO
# Comma-separated allowlist. Leave empty: frontend and API share one origin
# (Vite proxy in dev, nginx in demo), so CORS is not needed.
CORS_ALLOWED_ORIGINS=
RESTAURANT_TIMEZONE=Asia/Bishkek

# --- Auth (DEC-140) ---
# Required, no default: random secret of at least 32 characters. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Exact Origin values allowed for /auth/refresh and /auth/logout (CSRF).
# Not related to CORS_ALLOWED_ORIGINS. If unset, compose uses
# http://localhost:<port> and http://127.0.0.1:<port> of the current mode.
# CSRF_TRUSTED_ORIGINS=
# Argon2id (RFC 9106, 64 MiB); defaults shown.
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST_KIB=65536
# ARGON2_PARALLELISM=4

# --- Values used from later stages (DEC-80, DEC-84, DEC-87, DEC-59) ---
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
TELEGRAM_LINK_TOKEN_TTL_MINUTES=10
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_PASSWORD_FORGOT=3/hour
RATE_LIMIT_AUTHENTICATED=120/minute
RATE_LIMIT_PUBLIC=60/minute
PAYMENT_TIMEOUT_MINUTES=30
IDEMPOTENCY_KEY_TTL_HOURS=24

# Rate limits are kept in memory of the single API process (DEC-95).
# RATE_LIMIT_ENABLED=true

# --- E-mail (DEC-108): password reset letters; Mailpit catches them ---
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_FROM=Food Delivery Osh <no-reply@food-delivery.local>
# Public frontend URL used in reset links; compose sets it per mode.
# FRONTEND_BASE_URL=http://localhost:5173

# --- Telegram Mini App authentication (DEC-152, DEC-154) ---
# Bot token from BotFather. Empty means the Mini App endpoints answer
# 409 TELEGRAM_DISABLED. Never commit a real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_AUTH_MAX_AGE_SECONDS=3600
TELEGRAM_WEBAPP_INIT_DATA_MAX_LENGTH=4096
TELEGRAM_WEBAPP_CLOCK_SKEW_SECONDS=60
RATE_LIMIT_TELEGRAM_WEBAPP=5/minute

# --- Worker (DEC-104) ---
WORKER_HEARTBEAT_INTERVAL_SECONDS=10

# --- Public origin (only when the site is reached through another host) ---
# Behind HTTPS on a public host, set all three to that origin (see
# DEPLOYMENT.md): CSRF_TRUSTED_ORIGINS above, FRONTEND_BASE_URL above, and
# the bot's Mini App URL in BotFather. Example values only:
# CSRF_TRUSTED_ORIGINS=https://example.com
# FRONTEND_BASE_URL=https://example.com

# --- Sandbox mode (compose.sandbox.yaml) ---
# These two go into a separate, git-ignored `.env.sandbox`, not into `.env`:
# SANDBOX_POSTGRES_PASSWORD=
# SANDBOX_POSTGRES_USER=sandbox

# Other settings in backend/app/core/config.py (IMAGE_MAX_BYTES,
# PAYMENT_TIMEOUT_CHECK_INTERVAL_SECONDS, PAYMENT_TIMEOUT_BATCH_SIZE,
# SMTP_TIMEOUT_SECONDS, MEDIA_ROOT, ...) keep their code defaults: compose
# passes only the variables listed in compose.yaml to the containers.

# --- Optional host ports (all bound to 127.0.0.1); defaults shown ---
# FRONTEND_HOST_PORT=5173
# BACKEND_HOST_PORT=8000
# DB_HOST_PORT=5432
# TEST_DB_HOST_PORT=5433
# MAILPIT_UI_PORT=8025
# DEMO_HOST_PORT=8080
